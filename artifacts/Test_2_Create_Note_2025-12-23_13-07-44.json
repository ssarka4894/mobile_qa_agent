        "coordinates": [
          720,
          1500
        ],
        "wait_after": 1.0
      },
      {
        "step_number": 2,
        "description": "Tap on 'Untitled' title field",
        "from_state": "note_editor",
        "expected_state": "note_editor",
        "action": "tap",
        "coordinates": [
          400,
          400
        ],
        "wait_after": 0.3
      },
      {
        "step_number": 3,
        "description": "Delete 'Untitled' text",
        "from_state": "note_editor",
        "expected_state": "note_editor",
        "action": "keyevent",
        "keycode": 67,
        "repeat": 10,
        "wait_after": 0.3
